{
  "name": "laa-express-typescript-template",
  "version": "1.0.1",
  "private": true,
  "license": "MIT",
  "main": "public/index.js",
  "type": "module",
  "imports": {
    "#*": "./*"
  },
  "overrides": {
    "picomatch": "^4.0.0"
  },
  "scripts": {
    "start": "bun public/index.js",
    "clean": "rimraf public",
    "build": "bun run clean && bun esbuild.ts",
    "lint": "bunx eslint . --fix",
    "lint:check": "bunx eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dev": "concurrently \"bun esbuild.ts --watch\" \"bun --watch src/index.ts\"",
    "deploy": "./scripts/deploy.sh",
    "prepare": "command -v git >/dev/null 2>&1 && (git config --unset core.hooksPath 2>/dev/null || true) && bun lefthook install || echo 'Skipping lefthook install (git not found)'",
    "security:zap:ci": "./deploy/scripts/zap/zap-run-cicd.sh",
    "security:zap:local": "./deploy/scripts/zap/zap-run-local.sh",
    "test": "bun run test:unit && bun run test:playwright",
    "test:unit": "bun test ./tests/unit",
    "test:playwright": "mise build; bunx playwright test",
    "pretest:playwright": "docker rm -f wiremock-pw redis-pw-${REDIS_PORT:-6379} || true && docker run -d --name redis-pw-${REDIS_PORT:-6379} -p ${REDIS_PORT:-6379}:6379 redis:7-alpine",
    "posttest:playwright": "docker rm -f redis-pw-${REDIS_PORT:-6379} || true"
  },
  "engines": {
    "bun": ">=1.2.0"
  },
  "dependencies": {
    "@azure/msal-node": "^5.1.2",
    "@ministryofjustice/frontend": "^10.0.0",
    "@zod/core": "^0.11.6",
    "accessible-autocomplete": "^3.0.1",
    "axios": "1.19.0",
    "connect-redis": "^10.0.0",
    "cookie-parser": "~1.4.7",
    "csrf-sync": "^4.2.1",
    "dotenv": "^17.4.2",
    "eslint-plugin-unused-imports": "^4.4.1",
    "express": "^5.2.1",
    "express-prom-bundle": "^8.0.0",
    "express-rate-limit": "^8.3.2",
    "express-session": "^1.19.0",
    "fs-extra": "^11.3.4",
    "govuk-frontend": "^6.4.0",
    "helmet": "^8.2.0",
    "http-status-codes": "^2.3.0",
    "jwks-rsa": "^4.0.1",
    "multer": "^2.2.0",
    "nunjucks": "^3.2.4",
    "pino": "^10.0.0",
    "pino-http": "^11.0.0",
    "prom-client": "^15.1.3",
    "redis": "^6.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@playwright/test": "1.62.1",
    "@types/bun": "1.3.14",
    "@types/connect-livereload": "0.6.3",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/express-session": "1.19.0",
    "@types/fs-extra": "11.0.4",
    "@types/multer": "2.2.0",
    "@types/node": "26.1.2",
    "@types/nunjucks": "3.2.6",
    "@typescript-eslint/eslint-plugin": "8.66.0",
    "@typescript-eslint/parser": "8.66.0",
    "axe-core": "4.13.0",
    "chokidar": "5.0.0",
    "concurrently": "10.0.4",
    "connect-livereload": "0.6.1",
    "cross-env": "10.1.0",
    "eslint": "10.8.1",
    "eslint-config-love": "154.1.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-jsdoc": "63.3.3",
    "globals": "17.9.0",
    "lefthook": "2.1.10",
    "lint-staged": "17.3.0",
    "livereload": "0.10.3",
    "middleware-axios": "3.0.0",
    "pino-pretty": "13.1.3",
    "postcss": "8.5.26",
    "prettier": "3.9.6",
    "rimraf": "6.1.3",
    "sass": "1.102.0",
    "typescript": "6.0.3"
  },
  "lint-staged": {
    "*.{js,ts}": [
      "prettier --write",
      "eslint --fix"
    ]
  },
  "packageManager": "bun@1.3.13",
  "patchedDependencies": {
    "@ministryofjustice/frontend@10.0.0": "patches/@ministryofjustice%2Ffrontend@10.0.0.patch"
  }
}
